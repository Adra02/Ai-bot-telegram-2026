TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Local development can use polling.
# Vercel uses the webhook URL below.
TELEGRAM_WEBHOOK_URL=https://YOUR-PROJECT.vercel.app/api/telegram

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional persistent Redis storage for Vercel.
# Vercel Marketplace -> Upstash Redis can provide these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Some Vercel integrations use these names.
# The app accepts either naming scheme.
KV_REST_API_URL=
KV_REST_API_TOKEN=
